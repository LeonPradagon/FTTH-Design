NODE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_FTTH_URL=/ftth
VITE_GOOGLE_MAPS_API_KEY=

# Backend
PORT=3000
BETTER_AUTH_SECRET=change_me_generate_a_strong_secret
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=example123
INITIAL_DESIGNER_EMAIL=designer@example.com
INITIAL_DESIGNER_PASSWORD=example123

# Database
POSTGRES_DB=geospatial_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/geospatial_app
DATABASE_POOL_MAX=10

# GraphHopper routing
# These values are optional because compose provides the same defaults.
GRAPHHOPPER_URL=http://graphhopper:8989
GRAPHHOPPER_TIMEOUT_MS=15000
GRAPHHOPPER_PROFILE=motor_scooter
GRAPHHOPPER_OSM_URL=https://download.geofabrik.de/asia/indonesia-latest.osm.pbf
GRAPHHOPPER_FORCE_REBUILD=false
# Recommended for a backend-only 4 vCPU / 8 GiB server.
GRAPHHOPPER_JAVA_OPTS=-Xmx6g

# Local exposed ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432
GRAPHHOPPER_PORT=8989
