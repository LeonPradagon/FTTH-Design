# Copy this file to .env and replace both secrets with unique random values.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BACKEND_PROXY_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# For local use. Production should set the public URL on the Geospatial domain.
FTTH_APP_URL=http://localhost:5173/ftth
NEXT_PUBLIC_BASE_PATH=/ftth
FTTH_WEB_PORT=3301
FTTH_API_PORT=8101
FTTH_DB_PORT=5434
FTTH_STORAGE_PORT=8334

POSTGRES_DB=ftth
POSTGRES_USER=ftth
POSTGRES_PASSWORD=replace-this-database-password
