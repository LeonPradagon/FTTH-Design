{
  "name": "ftth-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "npm run build && node --test test/*.test.cjs",
    "start": "node dist/src/main.js",
    "osm:download": "node --env-file-if-exists=../../.env dist/src/scripts/download-osm-pbf.js",
    "osm:import": "node --env-file-if-exists=../../.env dist/src/scripts/import-osm-pbf.js",
    "osm:update": "node --env-file-if-exists=../../.env dist/src/scripts/import-osm-pbf.js --download true",
    "design:generate": "node --env-file-if-exists=../../.env dist/src/scripts/generate-design.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.44.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.0"
  }
}
