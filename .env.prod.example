POSTGRES_DB=ftth
POSTGRES_USER=ftth
POSTGRES_PASSWORD=replace-with-a-long-random-password
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=https://your-domain.example

# Credentials used only by the bundled, internal SeaweedFS service.
SEAWEEDFS_ACCESS_KEY_ID=ftth-local
SEAWEEDFS_SECRET_ACCESS_KEY=ftth-local-secret
SEAWEEDFS_BUCKET=ftth-designs

# S3-compatible app storage. Keep these equal to the SeaweedFS values above
# until STORAGE_ENDPOINT_URL is changed to an external OBS endpoint.
STORAGE_ENDPOINT_URL=http://seaweedfs:8333
STORAGE_ACCESS_KEY_ID=ftth-local
STORAGE_SECRET_ACCESS_KEY=ftth-local-secret
STORAGE_BUCKET=ftth-designs
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
